# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruitment_tracker?schema=public

# Redis & BullMQ
REDIS_URL=redis://localhost:6379

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_key_change_in_production_32char_min
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_change_in_prod
JWT_REFRESH_EXPIRES_IN=7d

# Email Transporter (SMTP / Dev Logger)
EMAIL_PROVIDER=log
EMAIL_FROM="Recruitment Portal" <no-reply@recruitmentportal.local>
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_SECURE=false
