  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 12px;
    margin-bottom: 24px;
    font-size: 10.5pt;
  }
  th {
    background-color: #1e3a8a;
    color: #ffffff;
    font-weight: bold;
    padding: 10px 12px;
    border: 1px solid #1e3a8a;
    text-align: left;
  }
  td {
    padding: 9px 12px;
    border: 1px solid #d1d5db;
    vertical-align: top;
  }
  tr:nth-child(even) td {
    background-color: #f8fafc;
  }
  .role-badge {
    display: inline-block;
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 9pt;
    font-weight: bold;
    color: #1e3a8a;
    background-color: #dbeafe;
    border: 1px solid #bfdbfe;
  }
  .password-code {
    font-family: 'Consolas', 'Courier New', monospace;
    font-weight: bold;
    color: #dc2626;
    background-color: #fee2e2;
    padding: 2px 6px;
    border-radius: 4px;
  }
  .email-code {
    font-family: 'Consolas', 'Courier New', monospace;
    color: #047857;
  }
  .callout {
    background-color: #eff6ff;
    border-left: 4px solid #3b82f6;
    padding: 14px 18px;
    margin: 16px 0;
    border-radius: 0 6px 6px 0;
  }
</style>
</head>
