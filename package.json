{
  "name": "smart-recruitment-lifecycle-tracker",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=recruitment-tracker-backend run dev",
    "dev:worker": "npm --workspace=recruitment-tracker-backend run worker",
    "dev:frontend": "npm --workspace=recruitment-tracker-frontend run dev",
    "build": "npm run build --workspaces",
    "test": "npm --workspace=recruitment-tracker-backend test"
  }
}
